{
  "name": "vera-anchor-js",
  "version": "0.2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT AND Commons-Clause",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hashing": {
      "types": "./dist/hashing/index.d.ts",
      "import": "./dist/hashing/index.js"
    },
    "./datasets": {
      "types": "./dist/datasets/index.d.ts",
      "import": "./dist/datasets/index.js"
    },
    "./ingest": {
      "types": "./dist/ingest/index.d.ts",
      "import": "./dist/ingest/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "npm run test:conformance",
    "test:conformance": "npm run build && node --test tests/conformance/datasets/datasetV1Conformance.test.mjs tests/conformance/ingest/ingestV1Conformance.test.mjs tests/conformance/ingest/remoteNetworkBoundary.test.mjs tests/conformance/ingest/pathNormParity.test.mjs",
    "test:conformance:datasets": "npm run build && node --test tests/conformance/datasets/datasetV1Conformance.test.mjs",
    "test:conformance:ingest": "npm run build && node --test tests/conformance/ingest/ingestV1Conformance.test.mjs"
  },
  "dependencies": {
    "picomatch": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.9.3"
  }
}
